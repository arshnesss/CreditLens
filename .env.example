# CreditLens AI Environment Configuration

# Application
APP_NAME=CreditLens AI
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api

# Server
HOST=0.0.0.0
PORT=8000

# Security & CORS
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Database
# For quick local run without docker, uses SQLite: sqlite:///./creditlens.db
# For PostgreSQL (e.g. in Docker Compose): postgresql://creditlens:creditlens_secret@localhost:5432/creditlens_db
DATABASE_URL=sqlite:///./creditlens.db

# Storage & ML Paths
DATA_DIR=./data
MODEL_DIR=./models

# Optional LLM API Key for Phase 5 AI Investigator Agent (e.g., OpenAI / Gemini / Anthropic)
# The system operates with deterministic analytical tools if no key is supplied
OPENAI_API_KEY=
